{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diffie",
  "version": "0.1.0",
  "identifier": "dev.diffie.app",
  "build": {
    "frontendDist": "src/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix src run dev",
    "beforeBuildCommand": "npm --prefix src run build"
  },
  "app": {
    "windows": [
      {
        "title": "Diffie",
        "width": 1400,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": ["icons/icon.png"]
  },
  "plugins": {}
}
